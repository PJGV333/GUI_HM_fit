+def _solve_absolute_checked(C, Y, W, ridge, mu, lower_bound, alpha_smooth, smooth_matrix, max_iters):
+    """Solve the separable, unregularized absolute problem and check its KKT.
+
+    Rank-deficient solutions remain explicitly unverified in the final report;
+    a demonstrable first-order failure is never returned as a successful solve.
+    """
+    if float(ridge) != 0.0 or float(mu) != 0.0 or float(alpha_smooth) != 0.0:
+        raise ValueError("bounded least-squares path requires an unregularized objective")
+    C, Y, W = (onp.asarray(v, dtype=float) for v in (C, Y, W))
+    if Y.ndim != 2 or Y.shape[1] != 1 or W.shape != Y.shape:
+        raise ValueError("bounded least-squares path requires one weighted column")
+    design = C * W[:, 0, None]
+    data = Y[:, 0] * W[:, 0]
+    if lower_bound is None:
+        solution = onp.linalg.lstsq(design, data, rcond=None)[0]
+    else:
+        lower = onp.broadcast_to(onp.asarray(lower_bound, dtype=float).reshape(-1), (C.shape[1],))
+        result = optimize.lsq_linear(design, data, bounds=(lower, onp.inf), method="bvls",
+                                     tol=1e-14, max_iter=int(max_iters))
+        if not result.success:
+            raise WeightedLinearSolveError("bounded least-squares failed: " + str(result.message))
+        solution = result.x
+    A = solution[:, None]
+    check = spectral_inner_optimality(
+        C, Y, A, eps_solver_mode="soft_bound" if lower_bound is not None else "soft_penalty",
+        weight_regularization_mode="absolute", lower_bound=lower_bound, weights_row=W,
+    )
+    if check["status"] == "not_converged":
+        raise WeightedLinearSolveError("bounded least-squares failed normalized optimality: " + check["reason"])
+    return np.asarray(A)
+
